# The `@elabs-ai` scope publishes to (and resolves from) the PUBLIC npm registry.
# Each package also pins it in `publishConfig.registry` for `pnpm release:publish`
# (Changesets). Consumers do NOT need this mapping (npmjs.org is npm's default
# registry); it is declared here so the target is explicit in the repo rather than
# implied. See docs/CONSUMING.md.
@elabs-ai:registry=https://registry.npmjs.org/

# Hoisting pattern for tooling that expects flat node_modules (Storybook, ESLint plugins).
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*storybook*
public-hoist-pattern[]=*@testing-library*
public-hoist-pattern[]=*vitest*
# Keep peer deps strict but auto-install React peers for a smoother DX.
auto-install-peers=true
strict-peer-dependencies=false
