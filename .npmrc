# No scoped registry is configured: `@elabs/components-*` are workspace packages
# and this repo does not publish. Adding one is what re-enables the release path
# — see docs/CONSUMING.md.

# Hoisting pattern for tooling that expects flat node_modules (Storybook, ESLint plugins).
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*storybook*
public-hoist-pattern[]=*@testing-library*
public-hoist-pattern[]=*vitest*
# Keep peer deps strict but auto-install React peers for a smoother DX.
auto-install-peers=true
strict-peer-dependencies=false
