{
  "//": "Website only (apps/home). Where a Storybook docs page sits on elabs-ai.com: which section, which package, which family, and which pages a top-level listing leads with. Story titles and ids are untouched. Read by scripts/lib/home-catalog.mjs, which fails the build on a name this file mentions that the catalogue does not have — so it cannot rot silently.",

  "visualizationFamilies": [
    "KPI Cards",
    "Stat Cards",
    "Infographics",
    "Editorial Charts",
    "Command Centers"
  ],

  "//moves": "Title prefix → where the page is filed instead of its default. `section` moves it out of Components (a use case, not a component); `package` re-homes a page Storybook keeps outside packages/; `group` names its family.",
  "moves": [
    { "prefix": "Layout/App Shell/", "section": "blocks", "group": "App Shells" },
    {
      "prefix": "Patterns/Blocks/Editorial table",
      "section": "visualizations",
      "group": "Editorial Charts"
    },
    {
      "prefix": "Patterns/Blocks/Table with sparklines",
      "section": "visualizations",
      "group": "Editorial Charts"
    },
    {
      "prefix": "Foundations/",
      "package": "tokens",
      "group": "Foundations",
      "onlyOutsidePackages": true
    },
    { "prefix": "AI/Composer/WithMentionInput", "package": "ai" },
    { "prefix": "Editor/AI Content Access", "package": "editor" }
  ],

