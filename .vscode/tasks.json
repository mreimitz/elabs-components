{
  // Start/stop tasks backing the debug profiles in launch.json.
  // The dev-server tasks are `isBackground` with a ready-matcher so a Chrome
  // debug launch waits until the server is actually up before attaching.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: storybook",
      "detail": "Start Storybook (docs) on http://localhost:6006, or reuse one that is already running",
      "type": "shell",
      // The wrapper owns the readiness handshake and prints its own markers — see the
      // comment block at the top of .vscode/start-storybook.mjs for why this does NOT
      // match on Storybook's own banner.
      "command": "node .vscode/start-storybook.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "storybook",
        "source": "storybook",
        "fileLocation": "absolute",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          // Markers printed by .vscode/start-storybook.mjs. __STORYBOOK_BOOT__ is printed
          // once, BEFORE the server starts; nothing printed afterwards can match it, so the
          // matcher can never re-arm and strand the task in its "active" state.
          "beginsPattern": "__STORYBOOK_BOOT__",
          "endsPattern": "__STORYBOOK_READY__"
        }
      },
      "presentation": {
        "group": "apps",
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "stop: storybook",
      "detail": "Kill the Storybook server on :6006 AND the task wrapper that started it",
      "type": "shell",
      // Killing only the SERVER is not enough. The wrapper process keeps running, so VS Code
      // still considers the "dev: storybook" task active and silently reuses that stale
      // execution on the next F5 — which never re-runs the command and never re-signals
      // ready, leaving the debug session stuck with nothing in the call stack.
      // stop-app.mjs kills both and returns only once the port is free — see its header for
      // why it replaced `npx kill-port`.
      "command": "node .vscode/stop-app.mjs storybook:6006",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    },
    {
      "label": "dev: home",
      "detail": "Start the website (apps/home) on http://localhost:3000, or reuse one already running from this checkout",
      "type": "shell",
      // Same handshake as "dev: storybook": the wrapper prints its own markers. See the
      // header of .vscode/start-home.mjs for why Next's "✓ Ready" line is not trusted.
      "command": "node .vscode/start-home.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "home",
        "source": "home",
        "fileLocation": "absolute",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "__HOME_BOOT__",
          "endsPattern": "__HOME_READY__"
        }
      },
      "presentation": {
        "group": "apps",
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "stop: home",
      "detail": "Kill the website server on :3000 AND the task wrapper that started it",
      "type": "shell",
      // Kill the wrapper too, for the same stale-task reason as "stop: storybook".
      "command": "node .vscode/stop-app.mjs home:3000",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    },
    {
      "label": "stop: all apps",
      "detail": "Kill the website (:3000) and Storybook (:6006) dev servers and their task wrappers",
      "type": "shell",
      "command": "node .vscode/stop-app.mjs home:3000 storybook:6006",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "close": false }
    }
  ]
}
