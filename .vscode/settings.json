{
  // Use the workspace's own TypeScript, not the one bundled with VS Code, so the
  // editor and `pnpm typecheck` resolve `extends`, paths and lib files identically.
  // Without this, a workspace-link change (a scope rename, a fresh `pnpm install`)
  // can leave the editor reporting module-resolution errors that the CLI does not.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Format on save with the repo's Prettier config — matches the pre-commit hook,
  // so an edit never lands unformatted and `pnpm format:check` stays green.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // ESLint resolves each package's flat config from that package's own directory.
  "eslint.workingDirectories": [{ "mode": "auto" }],

  // Claude Code subagents check out isolated worktrees into `.claude/worktrees/<unit>/` —
  // a FULL copy of the repo, `tsconfig.json` in every package included. Git ignores those
  // (.gitignore), but the editor does not: the TS server discovers each copy as its
  // own project, so every package gets typechecked once per live worktree, and when
  // the agent removes a worktree the diagnostics it opened outlive the folder
  // ("No inputs were found in config file '….claude/worktrees/<unit>/packages/ui/
  // tsconfig.json'") until the window is reloaded. Excluding the directory outright
  // is what stops both: the copies are transient and are never the source of truth.
  "files.exclude": { "**/.claude/worktrees": true, ".vscode/.chrome": true },
  // .vscode/.chrome/ holds the debug profiles' Chrome user-data folders (launch.json);
  // Chrome rewrites them constantly, so the editor must not watch them.
  "files.watcherExclude": { "**/.claude/worktrees/**": true, ".vscode/.chrome/**": true },
  "search.exclude": { "**/.claude/worktrees": true },
  "typescript.tsserver.watchOptions": { "excludeDirectories": ["**/.claude/worktrees"] },

  // F5 on a debug profile asks "Error exists after running preLaunchTask" whenever the
  // Problems panel holds ANY error anywhere in the workspace — VS Code counts every error
  // marker, not just the task's own (the dev-server tasks never report one; their
  // problem matchers only watch the wrapper's ready markers). A stray TypeScript or
  // workflow-lint error in an unrelated file must not block starting the app, so launch
  // anyway. A dev server that really fails to start prints why in its task terminal.
  "debug.onTaskErrors": "debugAnyway"
}
