{
  // Debug profiles for the two web apps: the website (apps/home, Next.js on :3000)
  // and Storybook (apps/docs, on :6006). Each launches Chrome with the debugger
  // attached (set breakpoints in .tsx source via source maps):
  //   - F5 / "Run" runs the `preLaunchTask` (starts the dev server, waits until
  //     it's ready) then opens the app in a debuggable Chrome.
  //   - Stop (Shift+F5) runs the `postDebugTask` (kills the dev server's port).
  // Chrome must be installed; swap "chrome" for "msedge" to use Edge instead.
  //
  // "🏠 Home + 📕 Storybook" starts both, each in its own Chrome window — one to set
  // breakpoints in site code, one for story code. The website's examples and /storybook/
  // links show a PACKAGED copy of this checkout's stories (.vscode/storybook-copy.mjs):
  // "dev: home" rebuilds it when a story or component changed (~1.5 min, otherwise
  // skipped) and serves it on :6007. A story edit shows in the Storybook window at once
  // and on the website after the next start. The dev Storybook itself made a page of 30
  // examples take 20–30 s to fill; set STORYBOOK_ORIGIN=http://localhost:6006 to use it
  // anyway.
  //
  // Each profile has its OWN `userDataDir`. js-debug's default profile folder is one
  // per workspace, so a second Chrome launched on it hands its URL to the first
  // window as an about:blank tab and exits, and the launch fails with "Unable to
  // attach to browser". The folders live under .vscode/.chrome/ (git-ignored by
  // .vscode/*, watcher-excluded in settings.json).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🏠 Home (website)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      // Turbopack source maps use absolute file:// paths, so breakpoints bind
      // without sourceMapPathOverrides.
      "webRoot": "${workspaceFolder}/apps/home",
      "userDataDir": "${workspaceFolder}/.vscode/.chrome/home",
      "preLaunchTask": "dev: home",
      "postDebugTask": "stop: home",
      "presentation": { "group": "1_apps", "order": 1 }
    },
    {
      "name": "📕 Storybook (Docs)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:6006",
      // apps/docs, not the repo root: Vite's root is apps/docs, so a pre-bundled dep
      // served at /node_modules/.cache/… lives in apps/docs/node_modules. With the
      // repo root here, its source map's ../../… paths resolved two folders ABOVE
      // the repo and every one logged "Could not read source map … ENOENT".
      // Workspace sources come over /@fs/<absolute path> and are unaffected.
      "webRoot": "${workspaceFolder}/apps/docs",
      "userDataDir": "${workspaceFolder}/.vscode/.chrome/storybook",
      // Diagnosing a failed launch? Add "trace": { "logFile": "${workspaceFolder}/.vscode/js-debug.log" }
      // here for one run only: it records every debugger message (tens of MB within minutes)
      // and slows the window down while it does.
      "preLaunchTask": "dev: storybook",
      "postDebugTask": "stop: storybook",
      "presentation": { "group": "1_apps", "order": 2 }
    }
  ],
  "compounds": [
    {
      "name": "🏠 Home + 📕 Storybook",
      "configurations": ["🏠 Home (website)", "📕 Storybook (Docs)"],
      // Stopping either tab stops both sessions (and each one's postDebugTask).
      "stopAll": true,
      "presentation": { "group": "0_all", "order": 0 }
    }
  ]
}
