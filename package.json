{
  "name": "brand-ui",
  "version": "5.4.0",
  "private": true,
  "description": "Open-source, source-owned, token-driven React component system built for coding agents: app UI, data grids, dashboards, AI/chat UIs, React Flow surfaces, maps and editors, with a CLI, MCP server and generated manifest as ground truth.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "a11y:baseline:run": "STORYBOOK_A11Y_MODE=todo pnpm --filter @elabs-ai/components-docs exec vitest --project storybook run --reporter=default --reporter=../../scripts/a11y-baseline-reporter.mjs",
    "brand-ui": "node packages/cli/bin/brand-ui.mjs",
    "build": "turbo run build",
    "check:changed": "turbo run typecheck lint test --filter=...[origin/main] --concurrency=1",
    "clean": "turbo run clean",
    "consumer:check": "node scripts/check-consumer-install.mjs",
    "create:matrix": "node scripts/create-matrix.mjs",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "lint": "turbo run lint",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "registry:build": "pnpm dlx shadcn@latest build registry/registry.json --output registry/__output",
    "release:agent-kit": "node scripts/gen.mjs --only templates,registry,manifest,llms && node scripts/build-agent-kit.mjs",
    "release:plugin": "node scripts/build-plugin.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "skills:build": "node scripts/build-skills.mjs",
    "storybook": "pnpm --filter @elabs-ai/components-docs dev",
    "site": "pnpm --filter @elabs-ai/home dev",
    "site:stories": "node apps/home/scripts/dev.mjs --stories-only",
    "surface:preview": "node scripts/build-surface-preview.mjs",
    "test": "turbo run test --concurrency=1",
    "test:stories": "pnpm --filter @elabs-ai/components-docs test-storybook",
    "test:contract": "pnpm --filter @elabs-ai/components-docs test-contract",
    "theme:new": "node scripts/new-community-theme.mjs",
    "typecheck": "turbo run typecheck",
    "check": "node scripts/check/run.mjs",
    "check:test": "node scripts/check/run.mjs --test",
    "check:update": "node scripts/check/run.mjs --update-baseline",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-version-extras.mjs && pnpm install --lockfile-only",
    "release:publish": "turbo run build --filter=./packages/* && changeset publish",
    "bench:run": "node scripts/bench/run.mjs",
    "bench:score": "node scripts/bench/score.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@elabs-ai/components-eslint-config": "workspace:*",
    "@elabs-ai/components-typescript-config": "workspace:*",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "@radix-ui/react-scroll-area@1.2.10": "patches/@radix-ui__react-scroll-area@1.2.10.patch",
      "@radix-ui/react-select@2.2.6": "patches/@radix-ui__react-select@2.2.6.patch",
      "@milkdown/ctx@7.21.2": "patches/@milkdown__ctx@7.21.2.patch"
    }
  }
}
