{
  "name": "brand-ui",
  "version": "4.1.0",
  "private": true,
  "description": "Internal, source-owned, token-driven React component system for internal apps, prototypes, POCs, AI/chat UIs, data grids, dashboards and React Flow surfaces.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "a11y:baseline:run": "STORYBOOK_A11Y_MODE=todo pnpm --filter @elabs-ai/components-docs exec vitest --project storybook run --reporter=default --reporter=../../scripts/a11y-baseline-reporter.mjs",
    "brand-ui": "node packages/cli/bin/brand-ui.mjs",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "check:changed": "turbo run typecheck lint test --filter=...[origin/main] --concurrency=1",
    "ci-scope": "node scripts/resolve-ci-scope.mjs",
    "ci-scope:test": "node --test scripts/resolve-ci-scope.test.mjs",
    "clean": "turbo run clean",
    "community-themes:check": "node scripts/check-community-themes.mjs",
    "community-themes:check:test": "node --test scripts/check-community-themes.test.mjs",
    "conflict-markers:check": "node scripts/check-conflict-markers.mjs",
    "conflict-markers:check:test": "node --test scripts/check-conflict-markers.test.mjs",
    "consumer:check": "node scripts/check-consumer-install.mjs",
    "consumer:check:test": "node --test scripts/check-consumer-install.test.mjs",
    "css-assets:check": "node scripts/check-css-assets.mjs",
    "css-assets:check:test": "node --test scripts/check-css-assets.test.mjs",
    "decoration-collapse:check": "node scripts/check-decoration-collapse.mjs",
    "decoration-collapse:check:test": "node --test scripts/check-decoration-collapse.test.mjs",
    "decoration:check": "node scripts/check-decoration-css.mjs",
    "decoration:check:test": "node --test scripts/check-decoration-css.test.mjs",
    "dep-field-move:check": "node scripts/check-package-json-dep-moves.mjs --staged",
    "dep-field-move:check:test": "node --test scripts/check-package-json-dep-moves.test.mjs",
    "deps-sync:test": "node --test scripts/ensure-deps-synced.test.mjs",
    "dev": "turbo run dev",
    "elevation:check": "node scripts/check-elevation.mjs",
    "elevation:check:test": "node --test scripts/check-elevation.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gates": "node scripts/run-gates.mjs",
    "gates:all": "node scripts/run-gates.mjs --all",
    "gates:selftests": "node scripts/run-gates.mjs --selftests",
    "gates:test": "node --test scripts/run-gates.test.mjs",
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "lint": "turbo run lint",
    "marketplace:check": "node scripts/release-smoke.mjs --pointer-only",
    "motion:check": "node scripts/check-motion-tokens.mjs",
    "motion:check:test": "node --test scripts/check-motion-tokens.test.mjs",
    "optional-peer-types:check": "node scripts/check-optional-peer-types.mjs",
    "optional-peer-types:check:test": "node --test scripts/check-optional-peer-types.test.mjs",
    "palette:check": "node scripts/check-raw-palette.mjs",
    "palette:check:test": "node --test scripts/check-raw-palette.test.mjs",
    "plugin:validate": "claude plugin validate . --strict",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "registry:build": "pnpm dlx shadcn@latest build registry/registry.json --output registry/__output",
    "registry:publish": "node scripts/publish-registry-pages.mjs",
    "registry:publish:test": "node --test scripts/publish-registry-pages.test.mjs",
    "registry:validate": "node scripts/validate-registry.mjs",
    "registry:validate:test": "node --test scripts/validate-registry.test.mjs",
    "release:agent-kit": "node scripts/gen.mjs --only templates,registry,manifest,llms && node scripts/build-agent-kit.mjs",
    "release:plugin": "node scripts/build-plugin.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:smoke:test": "node --test scripts/release-smoke.test.mjs",
    "skills:build": "node scripts/build-skills.mjs",
    "skills:build:check:test": "node --test scripts/build-skills.test.mjs",
    "source-theme-count:check": "node scripts/check-source-theme-count.mjs",
    "source-theme-count:check:test": "node --test scripts/check-source-theme-count.test.mjs",
    "storybook": "pnpm --filter @elabs-ai/components-docs dev",
    "surface-elevation:check": "node scripts/check-surface-elevation.mjs",
    "surface-elevation:check:test": "node --test scripts/check-surface-elevation.test.mjs",
    "surface:preview": "node scripts/build-surface-preview.mjs",
    "surface:preview:test": "node --test scripts/build-surface-preview.test.mjs",
    "tailwind-sources:check": "node scripts/check-tailwind-sources.mjs",
    "tailwind-sources:check:test": "node --test scripts/check-tailwind-sources.test.mjs",
    "test": "turbo run test --concurrency=1",
    "text-scale:check": "node scripts/check-text-scale.mjs",
    "text-scale:check:test": "node --test scripts/check-text-scale.test.mjs",
    "theme:new": "node scripts/new-community-theme.mjs",
    "theme-parity:check": "node scripts/check-theme-parity.mjs",
    "theme-parity:check:test": "node --test scripts/check-theme-parity.test.mjs",
    "tokens:check": "node scripts/check-tokens-fresh.mjs",
    "tokens:check:test": "node --test scripts/check-tokens-fresh.test.mjs",
    "tokens:dup-blocks:check": "node scripts/check-duplicate-theme-blocks.mjs",
    "tokens:dup-blocks:check:test": "node --test scripts/check-duplicate-theme-blocks.test.mjs",
    "tt-aliases:check": "node scripts/check-tt-aliases.mjs",
    "tt-aliases:check:test": "node --test scripts/check-tt-aliases.test.mjs",
    "typecheck": "turbo run typecheck",
    "token-contract:check": "pnpm --filter @elabs-ai/components-tokens tokens:names:check",
    "check": "node scripts/check/run.mjs",
    "check:test": "node scripts/check/run.mjs --test && node --test scripts/check/run.test.mjs",
    "check:docs": "node scripts/check/run.mjs --docs",
    "check:update": "node scripts/check/run.mjs --update-baseline",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-version-extras.mjs && pnpm install --lockfile-only",
    "release:publish": "pnpm build:packages && changeset publish",
    "version-sync:check": "node scripts/sync-version-extras.mjs --check",
    "version-sync:check:test": "node --test scripts/sync-version-extras.test.mjs",
    "a11y:baseline:update": "node scripts/a11y-baseline-update.mjs",
    "a11y:baseline:test": "node --test scripts/a11y-baseline-reporter.test.mjs",
    "gen:test": "node --test scripts/gen.test.mjs",
    "gen:templates:test": "node --test scripts/gen-templates.test.mjs",
    "gen:plugin-agents:test": "node --test scripts/gen-plugin-agents.test.mjs",
    "gen:attributions:test": "node --test scripts/gen-attributions.test.mjs",
    "gen:readmes:test": "node --test scripts/gen-package-readmes.test.mjs",
    "gen:registry:test": "node --test scripts/gen-registry.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@elabs-ai/components-eslint-config": "workspace:*",
    "@elabs-ai/components-typescript-config": "workspace:*",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "@radix-ui/react-scroll-area@1.2.10": "patches/@radix-ui__react-scroll-area@1.2.10.patch",
      "@radix-ui/react-select@2.2.6": "patches/@radix-ui__react-select@2.2.6.patch",
      "@milkdown/ctx@7.21.2": "patches/@milkdown__ctx@7.21.2.patch"
    }
  }
}
