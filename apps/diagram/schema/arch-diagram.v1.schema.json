{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brand-ui architecture diagram (dialect v1)",
  "description": "brand-ui architecture diagram, dialect v1.",
  "type": "object",
  "properties": {
    "component": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "One sentence about this diagram (Home, the collapsed reference)."
        },
        "extensionPoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          }
        },
        "icon": {
          "type": "string",
          "description": "Icon (vendor/name) of this diagram when another diagram references it."
        }
      },
      "additionalProperties": false,
      "description": "Describes this diagram as a reusable part (it usually lives under components/)."
    },
    "description": {
      "type": "string",
      "description": "One-sentence summary of the diagram, under the title on the canvas."
    },
    "diagram": {
      "enum": ["1", 1, "0", 0],
      "description": "Dialect version: \"1\". Files that say \"0\" still open."
    },
    "direction": {
      "enum": ["LR", "TB"],
      "default": "LR"
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flowItem"
      }
    },
    "layout": {
      "enum": ["auto", "manual"],
      "default": "auto"
    },
    "legend": {
      "anyOf": [
        {
          "enum": ["auto", "none"]
        },
        {
          "type": "array",
          "items": {
            "enum": ["owners", "providers", "edges"]
          }
        }
      ],
      "default": "auto"
    },
    "nodeStyle": {
      "enum": ["icon", "card"],
      "default": "icon"
    },
    "nodes": {
      "type": "array"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": ["at", "text"],
        "additionalProperties": false
      }
    },
    "story": {
      "type": "object",
      "properties": {
        "autoplay": {
          "type": "boolean",
          "description": "Reserved preference. Start playback with Play; stories never start automatically."
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "callouts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "at": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Node or zone endpoint id, including qualified inner ids."
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["at", "text"],
                  "additionalProperties": false
                },
                "maxItems": 20
              },
              "duration": {
                "type": "number",
                "minimum": 1,
                "maximum": 300,
                "default": 8
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 100,
                "description": "Node, zone, diagram instance, qualified inner id, or an existing flow expression."
              },
              "text": {
                "type": "string",
                "description": "Markdown narration; raw HTML and images are not rendered."
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["targets", "title"],
            "additionalProperties": false
          },
          "maxItems": 100
        }
      },
      "required": ["steps"],
      "additionalProperties": false
    },
    "styles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/style"
      }
    },
    "theme": {
      "type": "string",
      "description": "Brand theme family for the canvas."
    },
    "title": {
      "type": "string"
    },
    "visual": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "zones": {
      "type": "array"
    }
  },
  "required": ["diagram"],
  "additionalProperties": false,
  "if": {
    "required": ["layout"],
    "properties": {
      "layout": {
        "const": "manual"
      }
    }
  },
  "then": {
    "properties": {
      "zones": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/zone"
        }
      },
      "nodes": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/node"
        }
      }
    }
  },
  "else": {
    "properties": {
      "zones": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/zoneAuto"
        }
      },
      "nodes": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/nodeAuto"
        }
      }
    }
  },
  "$defs": {
    "zone": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "description": "Nested zones and nodes.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/zone"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        },
        "class": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Names of style classes defined in the diagram’s styles section."
        },
        "collapsed": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Longer supporting text."
        },
        "direction": {
          "enum": ["LR", "TB"]
        },
        "docs": {
          "type": "string",
          "description": "Link to the product's documentation (https://…)."
        },
        "icon": {
          "type": "string",
          "description": "Icon name vendor/name."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?$"
        },
        "kind": {
          "enum": [
            "cloud-account",
            "region",
            "vnet",
            "subnet",
            "cluster",
            "on-prem",
            "datacenter",
            "trust-boundary",
            "generic"
          ],
          "default": "generic"
        },
        "owner": {
          "enum": ["customer", "saas", "hosted", "partner"]
        },
        "parent": {
          "type": "string",
          "description": "Parent zone id (alternative to nesting)."
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": ["x", "y"],
          "additionalProperties": false,
          "description": "Top-left position; only under layout: manual."
        },
        "provider": {
          "type": "string",
          "description": "Vendor key, e.g. aws, azure, qlik."
        },
        "status": {
          "enum": ["ok", "degraded", "down", "planned"],
          "description": "Run state: ok, degraded, down or planned. Shown on the details card (DG-25)."
        },
        "subtitle": {
          "type": "string",
          "description": "Secondary line under the title."
        },
        "title": {
          "type": "string",
          "description": "Primary label."
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "zoneAuto": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "description": "Nested zones and nodes.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/zoneAuto"
              },
              {
                "$ref": "#/$defs/nodeAuto"
              }
            ]
          }
        },
        "class": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Names of style classes defined in the diagram’s styles section."
        },
        "collapsed": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Longer supporting text."
        },
        "direction": {
          "enum": ["LR", "TB"]
        },
        "docs": {
          "type": "string",
          "description": "Link to the product's documentation (https://…)."
        },
        "icon": {
          "type": "string",
          "description": "Icon name vendor/name."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?$"
        },
        "kind": {
          "enum": [
            "cloud-account",
            "region",
            "vnet",
            "subnet",
            "cluster",
            "on-prem",
            "datacenter",
            "trust-boundary",
            "generic"
          ],
          "default": "generic"
        },
        "owner": {
          "enum": ["customer", "saas", "hosted", "partner"]
        },
        "parent": {
          "type": "string",
          "description": "Parent zone id (alternative to nesting)."
        },
        "provider": {
          "type": "string",
          "description": "Vendor key, e.g. aws, azure, qlik."
        },
        "status": {
          "enum": ["ok", "degraded", "down", "planned"],
          "description": "Run state: ok, degraded, down or planned. Shown on the details card (DG-25)."
        },
        "subtitle": {
          "type": "string",
          "description": "Secondary line under the title."
        },
        "title": {
          "type": "string",
          "description": "Primary label."
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "badges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "class": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Names of style classes defined in the diagram’s styles section."
        },
        "description": {
          "type": "string",
          "description": "Longer supporting text."
        },
        "docs": {
          "type": "string",
          "description": "Link to the product's documentation (https://…)."
        },
        "expand": {
          "type": "boolean",
          "description": "Only when ref names a diagram: false draws it as one node, true draws its content inline as a zone.",
          "default": false
        },
        "href": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "Icon name vendor/name."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?$"
        },
        "parent": {
          "type": "string",
          "description": "Parent zone id (alternative to nesting)."
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": ["x", "y"],
          "additionalProperties": false,
          "description": "Top-left position; only under layout: manual."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "What this node is: catalog/<pack>/<entry> for a catalog item (catalog/aws/rds), or ws/<folder>/<file name> for another diagram. Keys written beside it override what it supplies.",
          "pattern": "^(?:catalog/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*|ws(?:/(?!_)(?!\\.)[^/\\\\\\s\\x00-\\x1f](?:[^/\\\\\\x00-\\x1f]*[^/\\\\\\s\\x00-\\x1f])?)+)$"
        },
        "status": {
          "enum": ["ok", "degraded", "down", "planned"],
          "description": "Run state: ok, degraded, down or planned. Shown on the details card (DG-25)."
        },
        "subtitle": {
          "type": "string",
          "description": "Secondary line under the title."
        },
        "text": {
          "type": "string",
          "description": "Body text of a note node."
        },
        "title": {
          "type": "string",
          "description": "Primary label."
        },
        "tone": {
          "enum": ["neutral", "info", "success", "warning", "destructive"]
        },
        "type": {
          "enum": ["service", "actor", "datastore", "queue", "external", "note"],
          "default": "service"
        },
        "variant": {
          "enum": ["icon", "card"]
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "nodeAuto": {
      "type": "object",
      "properties": {
        "badges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "class": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Names of style classes defined in the diagram’s styles section."
        },
        "description": {
          "type": "string",
          "description": "Longer supporting text."
        },
        "docs": {
          "type": "string",
          "description": "Link to the product's documentation (https://…)."
        },
        "expand": {
          "type": "boolean",
          "description": "Only when ref names a diagram: false draws it as one node, true draws its content inline as a zone.",
          "default": false
        },
        "href": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "Icon name vendor/name."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?$"
        },
        "parent": {
          "type": "string",
          "description": "Parent zone id (alternative to nesting)."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "What this node is: catalog/<pack>/<entry> for a catalog item (catalog/aws/rds), or ws/<folder>/<file name> for another diagram. Keys written beside it override what it supplies.",
          "pattern": "^(?:catalog/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*|ws(?:/(?!_)(?!\\.)[^/\\\\\\s\\x00-\\x1f](?:[^/\\\\\\x00-\\x1f]*[^/\\\\\\s\\x00-\\x1f])?)+)$"
        },
        "status": {
          "enum": ["ok", "degraded", "down", "planned"],
          "description": "Run state: ok, degraded, down or planned. Shown on the details card (DG-25)."
        },
        "subtitle": {
          "type": "string",
          "description": "Secondary line under the title."
        },
        "text": {
          "type": "string",
          "description": "Body text of a note node."
        },
        "title": {
          "type": "string",
          "description": "Primary label."
        },
        "tone": {
          "enum": ["neutral", "info", "success", "warning", "destructive"]
        },
        "type": {
          "enum": ["service", "actor", "datastore", "queue", "external", "note"],
          "default": "service"
        },
        "variant": {
          "enum": ["icon", "card"]
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "flowItem": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\s*([A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:\\.[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)*)\\s*(<->|->|<-)\\s*([A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:\\.[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)*)\\s*$",
          "description": "a -> b, a <- b, a <-> b"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "patternProperties": {
            "^\\s*([A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:\\.[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)*)\\s*(<->|->|<-)\\s*([A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:\\.[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)*)\\s*$": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/flowShorthandValue"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/flowObject"
        }
      ]
    },
    "flowObject": {
      "type": "object",
      "properties": {
        "animated": {
          "type": "boolean",
          "default": false
        },
        "class": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Names of style classes defined in the diagram’s styles section."
        },
        "direction": {
          "enum": ["forward", "back", "both"],
          "default": "forward"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["data", "request", "access", "control", "network"],
          "default": "data"
        },
        "label": {
          "type": "string"
        },
        "protocol": {
          "type": "string",
          "description": "Mono badge, e.g. HTTPS 443, JDBC, Kafka."
        },
        "schedule": {
          "type": "string",
          "description": "e.g. real-time, hourly, nightly batch."
        },
        "secure": {
          "enum": ["tls", "vpn", "private-link", "sso", "none"]
        },
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "style": {
          "enum": ["solid", "dashed", "dotted"]
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["from", "to"],
      "additionalProperties": false
    },
    "flowShorthandValue": {
      "type": "object",
      "properties": {
        "animated": {
          "type": "boolean",
          "default": false
        },
        "class": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Names of style classes defined in the diagram’s styles section."
        },
        "kind": {
          "enum": ["data", "request", "access", "control", "network"],
          "default": "data"
        },
        "label": {
          "type": "string"
        },
        "protocol": {
          "type": "string",
          "description": "Mono badge, e.g. HTTPS 443, JDBC, Kafka."
        },
        "schedule": {
          "type": "string",
          "description": "e.g. real-time, hourly, nightly batch."
        },
        "secure": {
          "enum": ["tls", "vpn", "private-link", "sso", "none"]
        },
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "style": {
          "enum": ["solid", "dashed", "dotted"]
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "badge": {
          "type": "string"
        },
        "tone": {
          "enum": ["neutral", "info", "success", "warning", "destructive"]
        }
      },
      "additionalProperties": false
    }
  }
}
