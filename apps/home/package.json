{
  "name": "@elabs-ai/home",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The elabs-ai.com website (ADR 0038). Built only from @elabs-ai/* packages and registry blocks.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev -p 3000",
    "prebuild": "pnpm -w registry:build && node scripts/copy-registry-output.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude \"e2e/**\"",
    "test:watch": "vitest --exclude \"e2e/**\"",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:update": "playwright test -c e2e/playwright.config.ts --update-snapshots",
    "lhci": "cd .next && lhci collect --config=../lighthouserc.json --collect.url=http://localhost:${E2E_PORT:-4620}/?lhci=desktop && lhci collect --config=../lighthouserc.json --additive --collect.settings.preset=perf --collect.url=http://localhost:${E2E_PORT:-4620}/?lhci=mobile && lhci assert --config=../lighthouserc.json && lhci upload --config=../lighthouserc.json",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "postinstall": "node ../../scripts/gen-home-themes.mjs",
    "clean": "rm -rf .next .turbo next-env.d.ts"
  },
  "dependencies": {
    "@elabs-ai/components-ai": "workspace:*",
    "@elabs-ai/components-charts": "workspace:*",
    "@elabs-ai/components-cli": "workspace:*",
    "@elabs-ai/components-data": "workspace:*",
    "@elabs-ai/components-editor": "workspace:*",
    "@elabs-ai/components-flow": "workspace:*",
    "@elabs-ai/components-icons": "workspace:*",
    "@elabs-ai/components-maps": "workspace:*",
    "@elabs-ai/components-marketing": "workspace:*",
    "@elabs-ai/components-process": "workspace:*",
    "@elabs-ai/components-terminal": "workspace:*",
    "@elabs-ai/components-tokens": "workspace:*",
    "@elabs-ai/components-ui": "workspace:*",
    "@elabs-ai/components-viewer": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.26.2",
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@elabs-ai/components-eslint-config": "workspace:*",
    "@elabs-ai/components-typescript-config": "workspace:*",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "ai": "^7.0.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
