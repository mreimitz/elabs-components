{
  "ci": {
    "collect": {
      "url": ["http://localhost:4620/?lhci=desktop"],
      "startServerCommand": "pnpm --filter @elabs-ai/home exec next start -p ${E2E_PORT:-4620}",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "lhci=desktop",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "interactive": [
              "error",
              {
                "maxNumericValue": 3000
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "lhci=mobile",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.8
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
