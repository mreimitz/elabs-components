{
  "name": "@elabs/components-data",
  "version": "3.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
