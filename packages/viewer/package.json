{
  "name": "@elabs-ai/components-viewer",
  "version": "4.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mreimitz/elabs-components.git",
    "directory": "packages/viewer"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/link-dist-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.2",
    "lucide-react": "^0.577.0"
  },
  "peerDependencies": {
    "@elabs-ai/components-tokens": "workspace:*",
    "@elabs-ai/components-ui": "workspace:*",
    "papaparse": "^5.4.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "pdfjs-dist": "^6.0.0",
    "mammoth": "^1.12.0",
    "xlsx": "^0.18.5",
    "jszip": "^3.10.1",
    "shiki": "^3.22.0",
    "streamdown": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "papaparse": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "streamdown": {
      "optional": true
    }
  },
  "devDependencies": {
    "@elabs-ai/components-eslint-config": "workspace:*",
    "@elabs-ai/components-tokens": "workspace:*",
    "@elabs-ai/components-typescript-config": "workspace:*",
    "@elabs-ai/components-ui": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^6.2.108",
    "xlsx": "^0.18.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^3.22.0",
    "streamdown": "^2.4.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
