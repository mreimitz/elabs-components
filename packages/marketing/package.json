    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@qlik-coe-emea/qlabs-components-eslint-config": "workspace:*",
    "@qlik-coe-emea/qlabs-components-tokens": "workspace:*",
    "@qlik-coe-emea/qlabs-components-typescript-config": "workspace:*",
    "@qlik-coe-emea/qlabs-components-ui": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
