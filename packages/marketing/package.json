{
  "name": "@qlik-coe-emea/qlabs-components-marketing",
  "version": "3.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qlik-CoE-EMEA/qlabs-components.git",
    "directory": "packages/marketing"
  },
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
