{
  "name": "@elabs/components-cli",
  "version": "3.1.0",
  "description": "brand-ui CLI — the deterministic backend for the brand-ui AI skills (component manifest, project context, search, docs, design audit).",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "brand-ui": "./bin/brand-ui.mjs"
  },
  "files": [
    "bin",
    "lib",
    "templates",
    "brand-ui.manifest.json"
  ],
  "scripts": {
    "manifest": "node ./bin/brand-ui.mjs manifest --write",
    "bundle": "node ./scripts/bundle-assets.mjs",
    "prepack": "node ./bin/brand-ui.mjs manifest --write && node ./scripts/bundle-assets.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "react-docgen-typescript": "^2.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
