{
  "name": "@elabs-ai/components-process",
  "version": "4.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mreimitz/elabs-components.git",
    "directory": "packages/process"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./test": {
      "types": "./src/test/index.ts",
      "default": "./src/test/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "./test": {
        "types": "./dist/test/index.d.ts",
        "default": "./dist/test/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "generate:fixtures": "tsx src/core/fixtures/generate-bpi-2012-subset-cli.ts",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.577.0"
  },
  "peerDependencies": {
    "@elabs-ai/components-charts": "workspace:*",
    "@elabs-ai/components-data": "workspace:*",
    "@elabs-ai/components-flow": "workspace:*",
    "@elabs-ai/components-tokens": "workspace:*",
    "@elabs-ai/components-ui": "workspace:*",
    "@xyflow/react": "^12.11.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@elabs-ai/components-charts": "workspace:*",
    "@elabs-ai/components-data": "workspace:*",
    "@elabs-ai/components-eslint-config": "workspace:*",
    "@elabs-ai/components-flow": "workspace:*",
    "@elabs-ai/components-icons": "workspace:*",
    "@elabs-ai/components-tokens": "workspace:*",
    "@elabs-ai/components-typescript-config": "workspace:*",
    "@elabs-ai/components-ui": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.11.1",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
