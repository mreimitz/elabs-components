{
  "name": "@elabs/components-blueprint",
  "version": "2.1.1",
  "private": true,
  "brandUi": {
    "paused": {
      "since": "2026-08-09",
      "reason": "Experimental drawing furniture for the paused `blueprint` theme. Kept as source; not built, tested, typechecked, linted, published or imported. See .claude/rules/paused-surfaces.md — un-pausing is a maintainer decision.",
      "unpause": "Remove `private` + `brandUi.paused`, restore the build/typecheck/lint/test scripts recorded below, drop the entry from PAUSED_PACKAGES in scripts/lib/paused-surfaces.mjs, re-add the Storybook glob and any consumer.",
      "archivedScripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest"
      }
    }
  },
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf dist .turbo coverage"
  },
  "peerDependencies": {
    "@elabs/components-tokens": "workspace:*",
    "@elabs/components-ui": "workspace:*",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@elabs/components-eslint-config": "workspace:*",
    "@elabs/components-tokens": "workspace:*",
    "@elabs/components-typescript-config": "workspace:*",
    "@elabs/components-ui": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
