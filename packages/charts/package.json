{
  "name": "@elabs-ai/components-charts",
  "version": "4.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mreimitz/elabs-components.git",
    "directory": "packages/charts"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test": {
      "types": "./src/test/index.ts",
      "default": "./src/test/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./test": {
        "types": "./dist/test/index.d.ts",
        "default": "./dist/test/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
