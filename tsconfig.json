{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./packages/typescript-config/base.json",
  "compilerOptions": {
    // The build scripts are .mjs (JS) — allow them as inputs so this editor-only
    // project resolves them instead of erroring with "No inputs found" (TS18003).
    "allowJs": true
  },
  "include": ["scripts/**/*.mjs"],
  "exclude": ["node_modules", "**/dist", "**/storybook-static"]
}
