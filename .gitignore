# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
storybook-static/
registry/__output/
*.tsbuildinfo

# Release staging + pack-time artifacts (throwaway; see docs/RELEASING.md)
release/
# The CLI ships the manifest + the archetype templates via its `prepack` copy
# (packages/cli/scripts/bundle-assets.mjs); both copies are generated — the
# canonical sources are the repo-root manifest and docs/playbooks/templates/**.
packages/cli/brand-ui.manifest.json
packages/cli/templates/

# Generated by `pnpm --filter @elabs-ai/components-process generate:fixtures` (RM-053) — a
# ~13k-case BPI-2012-shaped event log, too large to commit as a binary. See
# packages/process/src/core/fixtures/generate-bpi-2012-subset.write.ts.
packages/process/src/core/fixtures/bpi-2012-subset.json

# Turbo
.turbo/

# Test / coverage
coverage/

# Env & secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
# Pins the editor to the workspace TypeScript so the IDE and `pnpm typecheck`
# agree — must be shared, or every clone re-hits editor-only resolution errors.
!.vscode/settings.json
# Referenced by the "dev: storybook" task in tasks.json — must be shared, or a fresh
# clone gets a debug profile that points at a missing script.
!.vscode/start-storybook.mjs
*.log

# Claude Code local overrides (machine-specific, never shared)
.claude/settings.local.json

# Subagent isolation worktrees (transient; never commit an agent's workspace)
.claude/worktrees/

# Per-command run artifacts (transient; never commit scratch working files)
.claude/scratch/

# Generated per-harness skill mirrors (scripts/build-skills.mjs; canonical source is skills/)
.cursor/skills/
.gemini/skills/
.agents/skills/
.github/skills/

# Playwright / E2E artifacts
playwright-report/
blob-report/
test-results/
apps/e2e/.cache/

# tsup writes temp bundled config files next to tsup.config.ts
*.bundled_*.mjs

# axe ratchet measurement (#316) — one Storybook test run's raw axe result.
# The committed source of truth is scripts/a11y-baseline.json.
scripts/.a11y-run.json

# repo-cleanup audit output (#audit) — generated, machine-specific, never maintained
# source. The skill writes report/baseline/evidence here on every run.
.repo-cleanup/

# Benchmark runs (scripts/bench) — model output and throw-away apps; publish a
# run by copying its scores.md into docs/review/.
scripts/bench/out/
